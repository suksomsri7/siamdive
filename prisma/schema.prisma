// ── SocialAiConfig ──────────────────────────────────────────────────────────
// Singleton (id = "default") — independent from AiConfig (Ark AI). Lets the
// admin pick a cheap model (e.g. gpt-4o-mini via OpenRouter) for caption +
// hashtag generation without affecting Ark AI chat config.

model SocialAiConfig {
  id              String   @id @default("default")
  provider        String   @default("anthropic") // anthropic | openai | openrouter
  apiKeyEncrypted String   @default("")
  model           String   @default("claude-haiku-4-5-20251001")
  maxTokens       Int      @default(800)
  temperature     Float    @default(0.7)
  enabled         Boolean  @default(true)
  updatedAt       DateTime @updatedAt
}

// ── Social (Buffer) ─────────────────────────────────────────────────────────
// Per-page Buffer profile connected by an admin. Each Facebook Page (TH or EN)
// is one row. Tokens are encrypted at rest via lib/ark-ai/encryption.

model SocialAccount {
  id              String       @id @default(cuid())
  provider        String       @default("buffer") // future: native FB/IG/X
  bufferProfileId String       @unique
  pageName        String // e.g. "SiamDive TH"
  pageUrl         String       @default("")
  avatarUrl       String       @default("")
  language        String // "th" | "en" — used for auto-route from blog lang
  accessToken     String // encrypted
  refreshToken    String?
  expiresAt       DateTime?
  active          Boolean      @default(true)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  posts           SocialPost[]

  @@index([language, active])
}

model SocialPost {
  id             String           @id @default(cuid())
  blogId         String
  blog           Blog             @relation(fields: [blogId], references: [id], onDelete: Cascade)
  accountId      String
  account        SocialAccount    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  language       String // matches blog translation lang at compose time
  caption        String
  hashtags       String[]
  imageUrl       String           @default("")
  imageVariant   String           @default("og") // "og" | "square" | "custom" | "template:{id}"
  scheduledAt    DateTime?
  postedAt       DateTime?
  bufferUpdateId String?
  externalUrl    String?
  status         SocialPostStatus @default(QUEUED)
  errorMessage   String?
  // metrics (synced from Buffer)
  likes          Int?
  comments       Int?
  shares         Int?
  reach          Int?
  lastSyncedAt   DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([status, scheduledAt])
  @@index([blogId])
  @@index([accountId, createdAt])
}

enum SocialPostStatus {
  QUEUED
  POSTED
  FAILED
  CANCELLED
}

// User-defined and system image templates for social post composition.
// `layout` JSON holds the canvas spec (text blocks, watermark, position),
// rendered server-side via the photo-compose endpoint.
model SocialImageTemplate {
  id           String   @id @default(cuid())
  name         String
  width        Int
  height       Int
  layout       Json     @default("{}") // { background, texts: [], watermark: {...} }
  thumbnailUrl String   @default("")
  isSystem     Boolean  @default(false) // immutable when true
  order        Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([isSystem, order])
}

// ── RecommendationAiConfig ──────────────────────────────────────────────────
// Singleton (id = "default") — AI recommendation config, separate from Ark AI

model RecommendationAiConfig {
  id              String   @id @default("default")
  provider        String   @default("openrouter")
  apiKeyEncrypted String   @default("")
  model           String   @default("deepseek/deepseek-chat-v3-0324")
  maxTokens       Int      @default(512)
  temperature     Float    @default(0.3)
  minActivity     Int      @default(5)
  cacheTTLDays    Int      @default(7)
  cooldownMinutes Int      @default(60)
  abTestEnabled   Boolean  @default(false)
  enabled         Boolean  @default(false)
  updatedAt       DateTime @updatedAt
}

// ── RecommendationCache ─────────────────────────────────────────────────────
// On-demand AI recommendation results per visitor/user

model RecommendationCache {
  id            String   @id @default(cuid())
  deviceId      String?
  userId        String?
  boatIds       String[]
  scheduleIds   String[]
  reasons       String[]
  activityCount Int      @default(0)
  variant       String   @default("rule-based") // "ai" | "rule-based"
  computedAt    DateTime @default(now())
  expiresAt     DateTime

  @@unique([deviceId])
  @@unique([userId])
  @@index([expiresAt])
}

// ── Bookings ─────────────────────────────────────────────────────────────────
// Manual booking & payment ledger (backoffice-only). Records customer bookings
// per trip and tracks installment payments. NOT the public catalog/Schedule.

model BookingTrip {
  id          String            @id @default(cuid())
  name        String
  coverUrl    String? // cover image
  photos      String[]          @default([]) // gallery image URLs
  brochureUrl String? // PDF/brochure URL
  note        String?
  status      BookingTripStatus @default(ACTIVE)
  bookers     Booker[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([status])
}

model Booker {
  id           String               @id @default(cuid())
  trip         BookingTrip          @relation(fields: [tripId], references: [id], onDelete: Cascade)
  tripId       String
  order        Int                  @default(0) // ลำดับ — display order within a trip
  name         String
  email        String?
  phone        String?
  status       BookerStatus         @default(TENTATIVE)
  note         String? // อื่นๆ
  totalAmount  Float                @default(0) // ยอดทั้งหมด
  installments PaymentInstallment[]
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@index([tripId])
}

model PaymentInstallment {
  id         String            @id @default(cuid())
  booker     Booker            @relation(fields: [bookerId], references: [id], onDelete: Cascade)
  bookerId   String
  seq        Int               @default(1) // งวดที่ 1, 2, 3...
  amount     Float             @default(0) // ยอด
  dueDate    DateTime? // กำหนดชำระ
  paidAt     DateTime? // วันที่ชำระจริง
  status     InstallmentStatus @default(PENDING)
  proofUrl   String? // เอกสารการรับชำระ (สลิป)
  receiptUrl String? // ใบเสร็จ
  note       String?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@index([bookerId])
}

enum BookingTripStatus {
  ACTIVE
  ARCHIVED
}

enum BookerStatus {
  TENTATIVE // จองชั่วคราว
  CONFIRMED // ยืนยันแล้ว
  TRAVELED // เดินทางแล้ว
  CANCELLED // ยกเลิก
}

enum InstallmentStatus {
  PENDING // ยังไม่ชำระ
  PAID // ชำระแล้ว
}
