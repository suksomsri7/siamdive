// ── PlanAiSummary ───────────────────────────────────────────────────────────
// Cached AI-generated customer brief summary per plan

model PlanAiSummary {
  id          String   @id @default(cuid())
  planId      String   @unique
  summary     String
  eventCount  Int      @default(0)
  generatedAt DateTime @default(now())

  @@index([planId])
}

// ── Itinerary ────────────────────────────────────────────────────────────────

model Itinerary {
  id           String   @id @default(cuid())
  shortId      String   @unique
  title        String
  lang         String   @default("th")
  days         Json
  budget       Json
  boatIds      String[]
  blogIds      String[]
  totalDives   Int      @default(0)
  totalTours   Int      @default(0)
  areas        String[]
  durationDays Int      @default(1)
  viewCount    Int      @default(0)
  createdAt    DateTime @default(now())
  expiresAt    DateTime

  @@index([viewCount, createdAt])
  @@index([expiresAt])
}

// ── PlanUser ─────────────────────────────────────────────────────────────────

model PlanUser {
  id                  String     @id @default(cuid())
  deviceId            String     @unique
  email               String?
  name                String?
  avatarUrl           String?
  // Set by /api/plans/line-link when a user opens the LINE LIFF entry point.
  // Lets one human's plans follow them across devices once they tap the LINE
  // rich menu — the LIFF SDK gives us a stable LINE userId without a magic
  // link / password flow. lineDisplayName / linePictureUrl mirror name/avatarUrl
  // but kept separate so a user who later sets their own avatar via the web
  // app doesn't lose the LINE profile snapshot.
  lineUserId          String?    @unique
  lineDisplayName     String?
  linePictureUrl      String?
  recentlyDeletedSigs Json       @default("[]")
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  plans               UserPlan[]

  @@index([email])
}

// ── UserPlan ─────────────────────────────────────────────────────────────────

model UserPlan {
  id            String     @id @default(cuid())
  shortId       String     @unique @default(cuid())
  userId        String
  user          PlanUser   @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String     @default("My Plan")
  coverUrl      String?
  status        PlanStatus @default(PLANNING)
  trips         Json       @default("[]")
  isPublic      Boolean    @default(false)
  publicSlug    String?    @unique
  viewCount     Int        @default(0)
  shareCount    Int        @default(0)
  expiresAt     DateTime?
  source        String     @default("USER") // USER | ARK_AI | TEMPLATE
  aiPrompt      String?
  // SHA256 of normalized slot fields — set by /api/ark-ai/build-plan so a
  // repeat build with identical slots resolves to the existing plan instead
  // of creating a duplicate. NULL for non-AI plans. Partial unique index
  // (added in migration 20260509) enforces uniqueness only when set.
  planSignature String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  members       PlanMember[]
  media         PlanMedia[]
  checklists    PlanChecklist[]
  chatMessages  PlanChat[]
  activities    PlanActivity[]
  notifications PlanNotification[]
  items         PlanItem[]
  shareTokens   PlanShareToken[]

  @@index([userId])
  @@index([shortId])
  @@index([userId, planSignature])
}

// ── PlanShareToken ───────────────────────────────────────────────────────────
// Permission-bound link the owner generates from the share sheet. One token
// per (plan, role) pair — when an owner re-opens the share sheet for VIEWER
// it reuses the existing token instead of rotating, so previously sent links
// stay valid until the owner explicitly revokes.
// Recipients hit /plan/[shortId]/join?t={token} to either join as a member
// with the token's role or fork the plan into their own copy.
model PlanShareToken {
  id        String   @id @default(cuid())
  planId    String
  plan      UserPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  token     String   @unique @default(cuid())
  role      PlanRole
  createdAt DateTime @default(now())

  @@unique([planId, role])
  @@index([planId])
}

// ── PlanMember ───────────────────────────────────────────────────────────────

model PlanMember {
  id        String   @id @default(cuid())
  planId    String
  plan      UserPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  email     String
  name      String?
  avatarUrl String?
  role      PlanRole @default(VIEWER)
  certLevel String?
  joinedAt  DateTime @default(now())

  @@unique([planId, email])
  @@index([planId])
  @@index([email])
}

// ── PlanMedia ────────────────────────────────────────────────────────────────

model PlanMedia {
  id         String    @id @default(cuid())
  planId     String
  plan       UserPlan  @relation(fields: [planId], references: [id], onDelete: Cascade)
  url        String
  thumbUrl   String?
  type       MediaType @default(PHOTO)
  uploadedBy String
  caption    String?
  createdAt  DateTime  @default(now())

  @@index([planId, createdAt])
}

// ── PlanChecklist ────────────────────────────────────────────────────────────

model PlanChecklist {
  id         String   @id @default(cuid())
  planId     String
  plan       UserPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  category   String
  item       String
  assignedTo String?
  checked    Boolean  @default(false)
  checkedBy  String?
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([planId])
}

// ── PlanChat ─────────────────────────────────────────────────────────────────

model PlanChat {
  id          String   @id @default(cuid())
  planId      String
  plan        UserPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  authorEmail String
  authorName  String?
  message     String
  imageUrl    String?
  pinned      Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([planId, createdAt])
}

// ── PlanActivity ─────────────────────────────────────────────────────────────

model PlanActivity {
  id         String   @id @default(cuid())
  planId     String
  plan       UserPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  action     String
  actorEmail String
  detail     Json?
  createdAt  DateTime @default(now())

  @@index([planId, createdAt])
}

// ── PlanNotification ─────────────────────────────────────────────────────────
// Sprint 3 B5 — auto-improve cron writes here when it spots a state change
// worth surfacing to a PLANNING plan: a chosen schedule is near full, a new
// blog matching the plan's area was published, or a price drop was detected.
// The plan detail view reads active (dismissedAt IS NULL) rows on load.

model PlanNotification {
  id          String               @id @default(cuid())
  planId      String
  plan        UserPlan             @relation(fields: [planId], references: [id], onDelete: Cascade)
  type        PlanNotificationType
  title       String
  body        String
  payload     Json?
  scheduleId  String?
  blogId      String?
  dismissedAt DateTime?
  createdAt   DateTime             @default(now())

  @@index([planId, dismissedAt])
  @@index([createdAt])
}

enum PlanNotificationType {
  NEAR_FULL
  NEW_BLOG
  PRICE_DROP
  DATE_REMINDER
}

// ── PlanItem ────────────────────────────────────────────────────────────────
// Phase 4.5: flight/hotel/activity slots in the itinerary timeline.
// source=USER_INPUT (manual), AI_SUGGEST (Phase 4.6 tool-call), DB_SCHEDULE (boat from Schedule)
// searchQuery/alternatives are Phase 4.6 fields (lazy-load AI search results)

model PlanItem {
  id           String       @id @default(cuid())
  planId       String
  plan         UserPlan     @relation(fields: [planId], references: [id], onDelete: Cascade)
  type         PlanItemType
  title        String
  location     String?
  startAt      DateTime
  endAt        DateTime?
  externalUrl  String?
  bookingRef   String?
  cost         Float?
  currency     String?      @default("THB")
  source       String       @default("USER_INPUT")
  scheduleId   String?
  notes        String?
  order        Int          @default(0)
  searchQuery  Json?
  alternatives Json?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([planId, startAt])
  @@index([planId, type])
}

enum PlanItemType {
  FLIGHT
  HOTEL
  BOAT
  ACTIVITY
  TRANSFER
  NOTE
}

// ── SearchRateLimit ──────────────────────────────────────────────────────────
// Phase 4.6 — daily AI-search counter per plan. Survives Vercel cold-start
// (in-memory state gets wiped between serverless workers). Cleaned up by
// the date index — old rows are harmless and can be pruned periodically.

model SearchRateLimit {
  planId    String
  date      String
  count     Int      @default(0)
  updatedAt DateTime @default(now()) @updatedAt

  @@id([planId, date])
  @@index([date])
}

enum PlanStatus {
