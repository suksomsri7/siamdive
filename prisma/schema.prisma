  deviceId        String
  slots           Json     @default("{}") // {dates, headcount, region, certs[], budget, style, interests[]}
  status          String   @default("active") // active | completed | abandoned
  behaviorContext Json? // cached buildVisitorProfile() — refresh ทุก 1 ชม.
