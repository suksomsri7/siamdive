generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ── Admin ────────────────────────────────────────────────────────────────────

model Admin {
  id          String   @id @default(cuid())
  email       String   @unique
  password    String
  name        String
  role        String   @default("ADMIN")   // SUPER_ADMIN | ADMIN | EDITOR
  permissions String[]                      // granular keys for EDITOR role
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ── Blog ─────────────────────────────────────────────────────────────────────

model Blog {
  id           String            @id @default(cuid())
  status       BlogStatus        @default(DRAFT)
  covers       String[]                       // image URLs (cover variant) — public-facing
  imageIds     String[]          @default([]) // BlogImage IDs in same order as covers (for re-edit/cleanup)
  mjPrompt     String            @default("")
  translations BlogTranslation[]
  videos       BlogVideo[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
}

// Blog images with edit metadata for re-editing
model BlogImage {
  id          String   @id @default(cuid())
  originalUrl String   // /uploads/originals/<id>.<ext> — ภาพดั้งเดิม
  coverUrl    String   // /uploads/processed/<id>-cover.webp — 1200x800
  ogUrl       String   // /uploads/processed/<id>-og.jpg — 1200x630
  width       Int      @default(0)
  height      Int      @default(0)
  editJson    String   @default("{}")  // JSON: crop, watermark, text layers — สำหรับ re-edit
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Singleton model — ใช้ id = "default" เสมอ มีเพียง 1 row
model SiteBranding {
  id                  String   @id @default("default")
  watermarkUrl        String   @default("")  // legacy — เก็บไว้เพื่อ backward compat
  defaultWatermarkId  String   @default("")  // ID ของ Watermark default (ใช้ครั้งแรกเมื่อเปิด editor)
  watermarkEnabled    Boolean  @default(false)
  watermarkOpacity    Int      @default(60)  // 0-100
  watermarkPosition   String   @default("bottom-right")  // top-left | top-right | bottom-left | bottom-right | center
  watermarkScale      Int      @default(15)  // % ของความกว้างภาพ (เช่น 15 = logo กว้าง 15% ของภาพ)
  updatedAt           DateTime @updatedAt
}

// Watermark images (logos) — มีได้หลายอัน
model Watermark {
  id        String   @id @default(cuid())
  name      String   @default("")  // ชื่อ logo เช่น "White Logo", "Black Logo"
  url       String                 // URL ของ PNG โปร่งใส
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

model BlogTranslation {
  id       String   @id @default(cuid())
  blog     Blog     @relation(fields: [blogId], references: [id], onDelete: Cascade)
  blogId   String
  lang     String
  title    String
  slug     String
  excerpt       String   @default("")
  content       String   @default("")
  keywords      String[]
  ogTitle       String   @default("")
  ogDescription String   @default("")
  ogImage       String   @default("")

  @@unique([blogId, lang])
  @@unique([slug, lang])
}

model BlogVideo {
  id     String @id @default(cuid())
  blog   Blog   @relation(fields: [blogId], references: [id], onDelete: Cascade)
  blogId String
  url    String
  name   String
  order  Int    @default(0)
}

// ── Company ───────────────────────────────────────────────────────────────────

model Company {
  id           String               @id @default(cuid())
  logo         String?
  phone        String?
  email        String?
  lineId       String?
  status       ActiveStatus         @default(ACTIVE)
  covers       String[]
  photos       String[]
  boats        Boat[]
  translations CompanyTranslation[]
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
}

model CompanyTranslation {
  id          String  @id @default(cuid())
  company     Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId   String
  lang        String
  name        String
  description String  @default("")

  @@unique([companyId, lang])
}

// ── Boat ──────────────────────────────────────────────────────────────────────
// Boat IS the product listing (daytrip or liveaboard)

model Boat {
  id           String            @id @default(cuid())
  company      Company?          @relation(fields: [companyId], references: [id], onDelete: SetNull)
  companyId    String?
  name         String            // internal boat name e.g. "MV Manta Queen 5"
  type         BoatType
  capacity     Int?
  photos       String[]          // boat photos (interior/exterior)
  covers       String[]          // product listing cover images
  status       PublishStatus     @default(DRAFT)
  featured     Boolean           @default(false)
  translations  BoatTranslation[]
  videos        BoatVideo[]
  priceTiers    BoatPriceTier[]
  schedules     Schedule[]
  packages      Package[]
  options       BoatOption[]
  serviceAreas  BoatServiceArea[]
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
}

model BoatTranslation {
  id       String   @id @default(cuid())
  boat     Boat     @relation(fields: [boatId], references: [id], onDelete: Cascade)
  boatId   String
  lang     String
  title    String   @default("")  // product listing title
  slug     String   @default("")
  excerpt  String   @default("")
  content  String   @default("")
  keywords String[]

  @@unique([boatId, lang])
}

model BoatVideo {
  id     String @id @default(cuid())
  boat   Boat   @relation(fields: [boatId], references: [id], onDelete: Cascade)
  boatId String
  url    String
  name   String
  order  Int    @default(0)
}

model BoatPriceTier {
  id           String  @id @default(cuid())
  boat         Boat    @relation(fields: [boatId], references: [id], onDelete: Cascade)
  boatId       String
  tier         String  // ADULT | CHILD | NON_DIVER | DIVER
  costPrice    Float?
  regularPrice Float
  salePrice    Float?
  agentPrice   Float?

  @@unique([boatId, tier])
}

// ── Schedule ──────────────────────────────────────────────────────────────────

model Schedule {
  id             String                @id @default(cuid())
  boat           Boat                  @relation(fields: [boatId], references: [id], onDelete: Cascade)
  boatId         String
  dateType       String                @default("single")
  departureDate  DateTime?
  returnDate     DateTime?
  weekDays       String[]
  totalSeats     Int?
  availableSeats Int?
  status         ScheduleStatus        @default(OPEN)
  season         String?               // HIGH_SEASON | PEAK_SEASON | GREEN_SEASON | ALL_SEASON
  note           String?
  itinerary      String                @default("")
  translations   ScheduleTranslation[]
  packages       SchedulePackage[]
  createdAt      DateTime              @default(now())
}

model SchedulePackage {
  id                   String                     @id @default(cuid())
  schedule             Schedule                   @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  scheduleId           String
  package              Package                    @relation(fields: [packageId], references: [id], onDelete: Cascade)
  packageId            String
  availableSeats       Int?
  isFull               Boolean                    @default(false)
  appendScheduleDetail Boolean                    @default(false)
  priceTiers           SchedulePackagePriceTier[]

  @@unique([scheduleId, packageId])
}

model SchedulePackagePriceTier {
  id                String          @id @default(cuid())
  schedulePackage   SchedulePackage @relation(fields: [schedulePackageId], references: [id], onDelete: Cascade)
  schedulePackageId String
  tier              String
  costPrice         Float?
  regularPrice      Float           @default(0)
  salePrice         Float?
  agentPrice        Float?

  @@unique([schedulePackageId, tier])
}

model ScheduleTranslation {
  id         String   @id @default(cuid())
  schedule   Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  scheduleId String
  lang       String
  title      String   @default("")
  slug       String   @default("")
  excerpt    String   @default("")
  content    String   @default("")
  itinerary  String   @default("")
  route      String   @default("")
  keywords   String[]

  @@unique([scheduleId, lang])
}

// ── Package ───────────────────────────────────────────────────────────────────

model Package {
  id            String                 @id @default(cuid())
  boat          Boat                   @relation(fields: [boatId], references: [id], onDelete: Cascade)
  boatId        String
  name          String                 // internal name
  totalSeats    Int?
  photos        String[]               // package gallery photos (unlimited)
  status        PublishStatus          @default(DRAFT)
  translations  PackageTranslation[]
  priceTiers    PackagePriceTier[]
  seasonPeriods PackageSeasonPeriod[]
  schedules     SchedulePackage[]
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
}

model PackageSeasonPeriod {
  id        String   @id @default(cuid())
  package   Package  @relation(fields: [packageId], references: [id], onDelete: Cascade)
  packageId String
  season    String   // HIGH_SEASON | PEAK_SEASON | GREEN_SEASON | ALL_SEASON
  startDate DateTime
  endDate   DateTime
}

model PackageTranslation {
  id        String  @id @default(cuid())
  package   Package @relation(fields: [packageId], references: [id], onDelete: Cascade)
  packageId String
  lang      String
  title     String  @default("")
  slug      String  @default("")
  excerpt   String  @default("")
  content   String  @default("")    // detail
  itinerary String  @default("")
  route     String  @default("")    // เส้นทาง
  keywords  String[]

  @@unique([packageId, lang])
}

model BoatOption {
  id           String                  @id @default(cuid())
  boat         Boat                    @relation(fields: [boatId], references: [id], onDelete: Cascade)
  boatId       String
  price        Float                   @default(0)
  order        Int                     @default(0)
  translations BoatOptionTranslation[]
}

model BoatOptionTranslation {
  id          String     @id @default(cuid())
  option      BoatOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  optionId    String
  lang        String
  name        String     @default("")
  description String     @default("")

  @@unique([optionId, lang])
}

model PackagePriceTier {
  id           String  @id @default(cuid())
  package      Package @relation(fields: [packageId], references: [id], onDelete: Cascade)
  packageId    String
  tier         String  // DIVER | NON_DIVER
  costPrice    Float?
  regularPrice Float   @default(0)
  salePrice    Float?
  agentPrice   Float?

  @@unique([packageId, tier])
}

// ── ServiceArea ───────────────────────────────────────────────────────────────

model ServiceArea {
  id           String                   @id @default(cuid())
  translations ServiceAreaTranslation[]
  boats        BoatServiceArea[]
  displayRows  DisplayRow[]
}

model ServiceAreaTranslation {
  id            String      @id @default(cuid())
  serviceArea   ServiceArea @relation(fields: [serviceAreaId], references: [id], onDelete: Cascade)
  serviceAreaId String
  lang          String
  name          String      @default("")

  @@unique([serviceAreaId, lang])
}

model BoatServiceArea {
  boatId        String
  serviceAreaId String
  boat          Boat        @relation(fields: [boatId], references: [id], onDelete: Cascade)
  serviceArea   ServiceArea @relation(fields: [serviceAreaId], references: [id], onDelete: Cascade)

  @@id([boatId, serviceAreaId])
}

// ── School ────────────────────────────────────────────────────────────────────

model School {
  id           String              @id @default(cuid())
  logo         String?
  certBody     String              // PADI | SSI | NAUI | CMAS | SDI | TDI
  phone        String?
  email        String?
  lineId       String?
  website      String?
  serviceArea  String?
  keywords     String[]
  status       ActiveStatus        @default(ACTIVE)
  courses      Course[]
  translations SchoolTranslation[]
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
}

model SchoolTranslation {
  id          String @id @default(cuid())
  school      School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  schoolId    String
  lang        String
  name        String
  description String @default("")
  information String @default("")

  @@unique([schoolId, lang])
}

// ── Course ────────────────────────────────────────────────────────────────────

model Course {
  id           String              @id @default(cuid())
  school       School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  schoolId     String
  level        String?
  duration     Int?
  status       PublishStatus       @default(DRAFT)
  covers       String[]
  translations CourseTranslation[]
  videos       CourseVideo[]
  price        CoursePrice?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
}

model CourseTranslation {
  id       String   @id @default(cuid())
  course   Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseId String
  lang     String
  title    String
  slug     String   @unique
  excerpt  String   @default("")
  content  String   @default("")
  keywords String[]

  @@unique([courseId, lang])
}

model CourseVideo {
  id       String @id @default(cuid())
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseId String
  url      String
  name     String
  order    Int    @default(0)
}

model CoursePrice {
  id           String  @id @default(cuid())
  course       Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseId     String  @unique
  costPrice    Float?
  regularPrice Float
  salePrice    Float?
  agentPrice   Float?
}

// ── Display ───────────────────────────────────────────────────────────────────

model DisplayRow {
  id           String                   @id @default(cuid())
  topic        String                   // internal name (backoffice only)
  layout       String                   @default("HORIZONTAL") // FULL | VERTICAL | HORIZONTAL
  itemType     String                   // DAYTRIP | LIVEABOARD | DIVE_RESORT | FREEDIVE | LAND_TOUR | SNORKELING | SCUBA_COURSES | FREEDIVE_COURSES | BLOG
  order        Int                      @default(0)
  active       Boolean                  @default(true)
  maxItems     Int?                     // null = show all
  // When true (BLOG rows only): ignore curated `items` and pull the most recent
  // PUBLISHED blogs (capped at maxItems ?? 20). Useful for "latest articles" rows
  // that auto-update without admin intervention.
  autoLatest   Boolean                  @default(false)
  // When true (BLOG rows only): shuffle a random selection of PUBLISHED blogs
  // from the newest 50 pool, capped at maxItems ?? 20. Reshuffles on every page
  // load. If both autoLatest and randomMode are true, randomMode wins.
  randomMode   Boolean                  @default(false)
  // When true (non-BLOG rows with itemType in LIVEABOARD|DAYTRIP|DIVE_RESORT|
  // LAND_TOUR): replace curated `items` with the top boats ranked by TRIP_VIEW
  // events over the last 7 days, capped at maxItems ?? 6. Only counts events
  // from bot-filtered sessions. Falls back to curated items if analytics returns
  // fewer boats than maxItems.
  autoTrending  Boolean                  @default(false)
  serviceAreaId String?
  serviceArea   ServiceArea?             @relation(fields: [serviceAreaId], references: [id])
  items         DisplayRowItem[]
  translations DisplayRowTranslation[]
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt
}

model DisplayRowTranslation {
  id       String     @id @default(cuid())
  row      DisplayRow @relation(fields: [rowId], references: [id], onDelete: Cascade)
  rowId    String
  lang     String
  title    String     @default("")    // heading shown on frontend
  subtitle String     @default("")    // optional tagline, hidden if empty

  @@unique([rowId, lang])
}

model DisplayRowItem {
  id      String     @id @default(cuid())
  row     DisplayRow @relation(fields: [rowId], references: [id], onDelete: Cascade)
  rowId   String
  refId   String     // schedule.id | package.id | blog.id
  refType String     @default("SCHEDULE") // SCHEDULE | PACKAGE | BLOG
  order   Int        @default(0)

  @@unique([rowId, refId])
}

// ── SiteSeo ───────────────────────────────────────────────────────────────────

model SiteSeo {
  lang          String   @id          // "en" | "th" | "cn" | "ja" | "ko" | "de" | "fr" | "ru"
  title         String   @default("")
  description   String   @default("")
  keywords      String[]
  ogTitle       String   @default("")
  ogDescription String   @default("")
  ogImage       String   @default("")
  updatedAt     DateTime @updatedAt
}

// ── ApiKey ────────────────────────────────────────────────────────────────────

model ApiKey {
  id          String    @id @default(cuid())
  name        String
  keyHash     String    @unique  // SHA-256 of full key
  keyPrefix   String             // "sk_xxxxxxxx" first 12 chars for display
  permissions String[]           // ["boats.read", "schedules.write", ...]
  active      Boolean   @default(true)
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// ── BlogTopic ─────────────────────────────────────────────────────────────────
// Topic backlog that feeds the blog generator cron. Each topic is consumed
// once — the generator picks the oldest unused topic in the rotated category,
// marks it used, and links the resulting blog id for audit.

model BlogTopic {
  id        String    @id @default(cuid())
  category  BlogCategory
  title     String // short angle/hook, not the final blog title
  keywords  String[]  @default([])
  note      String    @default("") // optional hint for the writer
  used      Boolean   @default(false)
  usedAt    DateTime?
  blogId    String?   // set after a blog is generated from this topic
  order     Int       @default(0)
  createdAt DateTime  @default(now())

  @@index([category, used, order])
}

// ── CronState ─────────────────────────────────────────────────────────────────
// Singleton row (id = "default") storing global flags for scheduled work:
// kill switches, last-run timestamps, rotation counters.

model CronState {
  id                  String   @id @default("default")
  autoPublishEnabled  Boolean  @default(false)
  generatorEnabled    Boolean  @default(true)
  lastGeneratedAt     DateTime?
  lastPublishedAt     DateTime?
  categoryRotationIdx Int      @default(0) // rotates 0..5 each generator run
  publishedToday      Int      @default(0)
  publishedDate       String   @default("") // YYYY-MM-DD in BKK tz
  updatedAt           DateTime @updatedAt
}

// ── CronAuditLog ──────────────────────────────────────────────────────────────
// Per-event trail for generator + publisher actions. Useful for debugging and
// for answering "why did this blog publish at 03:00".

model CronAuditLog {
  id        String   @id @default(cuid())
  event     String   // generator.started | generator.picked | generator.completed | publisher.picked | publisher.skipped | publisher.published
  blogId    String?
  topicId   String?
  category  String?
  detail    String   @default("")
  createdAt DateTime @default(now())

  @@index([event, createdAt])
  @@index([blogId])
}

// ── Analytics ────────────────────────────────────────────────────────────────
// Custom analytics: 5 tables, anonymous, marketing/SEO focused.
// See memory/project_siamdive_analytics.md for full design rationale.

model AnalyticsSession {
  id             String   @id                       // client-generated uuid v4
  visitorId      String                             // stable across sessions (localStorage)
  startedAt      DateTime @default(now())
  lastSeenAt     DateTime @default(now())
  eventCount     Int      @default(0)
  pageCount      Int      @default(0)

  // Geo (from Vercel headers; raw IP never stored)
  country        String?
  region         String?
  city           String?

  // Device (parsed UA; raw UA never stored)
  device         String?                            // mobile | tablet | desktop
  os             String?
  browser        String?

  // First-touch (locked after first set)
  firstUtmSource   String?
  firstUtmMedium   String?
  firstUtmCampaign String?
  firstUtmTerm     String?
  firstUtmContent  String?
  firstReferrer    String?
  firstLandingPath String?

  // Last-touch
  lastUtmSource    String?
  lastUtmMedium    String?
  lastUtmCampaign  String?

  lang             String?
  isBot            Boolean  @default(false)

  events       AnalyticsEvent[]
  attributions AnalyticsAttribution[]

  @@index([startedAt])
  @@index([visitorId])
  @@index([country, startedAt])
  @@index([isBot, startedAt])
}

model AnalyticsEvent {
  id          BigInt              @id @default(autoincrement())
  ts          DateTime            @default(now())
  sessionId   String
  visitorId   String

  type        AnalyticsEventType
  path        String                             // "/trips/aquarian-similan"
  lang        String?

  // Polymorphic entity reference
  entityType  String?                            // BOAT | SCHEDULE | BLOG | TOPIC | ROW
  entityId    String?

  // Engagement
  dwellMs     Int?
  scrollPct   Int?
  viewportW   Int?
  viewportH   Int?

  // Free-form (search query, filter values, A/B variant, etc.)
  properties  Json?

  session     AnalyticsSession    @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([ts])
  @@index([type, ts])
  @@index([entityType, entityId, ts])
  @@index([sessionId])
  @@index([visitorId, ts])
}

model AnalyticsSearch {
  id             BigInt   @id @default(autoincrement())
  ts             DateTime @default(now())
  sessionId      String
  visitorId      String
  queryRaw       String
  queryNorm      String                          // lowercase trim no-punct
  lang           String?
  country        String?
  resultsCount   Int                             // 0 = SEO opportunity
  filters        Json?                           // {dateFrom, dateTo, boatType, ...}
  clickedResult  String?                         // entity id that was clicked (null = no click)
  clickedRank    Int?                            // 1-based

  @@index([ts])
  @@index([queryNorm])
  @@index([resultsCount, ts])
  @@index([sessionId])
}

model AnalyticsAttribution {
  id                   BigInt              @id @default(autoincrement())
  ts                   DateTime            @default(now())
  sessionId            String
  visitorId            String

  intentType           AnalyticsEventType  // BOOKING_INTENT_*
  targetType           String              // BOAT | SCHEDULE
  targetId             String
  targetPriceTHB       Int?
  scheduleDate         DateTime?

  // Snapshot (avoid join when aggregating)
  firstUtmSource       String?
  firstUtmMedium       String?
  firstUtmCampaign     String?
  firstReferrer        String?

  // Marketing efficiency signals
  msFromSessionStart   Int?
  sessionsBeforeIntent Int?

  // Future hook: external booking confirmation
  confirmed            Boolean             @default(false)
  confirmedAt          DateTime?
  confirmedValueTHB    Int?

  session              AnalyticsSession    @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([ts])
  @@index([targetType, targetId, ts])
  @@index([firstUtmSource, ts])
  @@index([confirmed, ts])
}

model AnalyticsDaily {
  id             BigInt   @id @default(autoincrement())
  date           DateTime                          // BKK date normalized to 00:00
  entityType     String                            // BOAT | SCHEDULE | BLOG | PATH | SEARCH
  entityId       String                            // id / path / queryNorm
  country        String?                           // null = all-countries roll-up
  device         String?                           // null = all-devices roll-up

  views          Int      @default(0)
  uniqueVisitors Int      @default(0)
  uniqueSessions Int      @default(0)
  avgDwellMs     Int?
  avgScrollPct   Int?
  reads          Int      @default(0)              // BLOG_READ_COMPLETE
  intents        Int      @default(0)              // BOOKING_INTENT_*

  @@unique([date, entityType, entityId, country, device])
  @@index([date, entityType])
  @@index([entityType, entityId, date])
}

// ── Enums ─────────────────────────────────────────────────────────────────────

enum BlogStatus {
  DRAFT
  APPROVED
  PUBLISHED
}

enum BlogCategory {
  DIVE_SITES
  MARINE_LIFE
  GEAR
  WHY_THAILAND
  SAFETY
  EDUCATION
  CONSERVATION
  WORLD_DIVE_SITES
}

enum ActiveStatus {
  ACTIVE
  INACTIVE
}

enum PublishStatus {
  DRAFT
  PUBLISHED
}

enum BoatType {
  DAYTRIP
  LIVEABOARD
  DIVE_RESORT
  FREEDIVE
  LAND_TOUR
  SNORKELING
  SCUBA_COURSES
  FREEDIVE_COURSES
  SCUBA_INSTRUCTOR
  FREEDIVE_INSTRUCTOR
}

enum ScheduleStatus {
  DRAFT
  OPEN
  FULL
  CANCELLED
  COMPLETED
}

enum AnalyticsEventType {
  PAGE_VIEW
  ROW_CLICK
  LANGUAGE_SWITCH
  TRIP_VIEW
  SCHEDULE_VIEW
  SCHEDULE_SHARE
  BLOG_VIEW
  BLOG_READ_COMPLETE
  SEARCH
  SEARCH_RESULT_CLICK
  FILTER_APPLY
  BOOKING_INTENT_LINE
  BOOKING_INTENT_WHATSAPP
  BOOKING_INTENT_EMAIL
  BOOKING_INTENT_CALL
  BOOKING_INTENT_MESSENGER
  BOOKING_INTENT_WECHAT
  SESSION_START
  SESSION_END
  ERROR
}
